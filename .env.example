# ---------------------------------------------------------------------------
# Copia este archivo a .env.local y llena los valores. Ver SETUP.md.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Google AI Studio → https://aistudio.google.com/apikey (plan gratis)
# Sólo se usa en el servidor: nunca llega al navegador.
GEMINI_API_KEY=tu-api-key-de-gemini

# Opcional. Por defecto usa gemini-2.5-flash y cae a gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.5-flash
